{
  "name": "classwiz-qr",
  "version": "0.0.1",
  "description": "ClassWiz QR Parser",
  "main": "./dist/cwqr.cjs",
  "module": "./dist/cwqr.mjs",
  "browser": "./dist/cwqr.js",
  "exports": {
    ".": {
      "import": "./dist/cwqr.mjs",
      "require": "./dist/cwqr.cjs"
    },
    "./i18n/*.json": "./src/i18n-res/*.json"
  },
  "files": [
    "dist/cwqr.js",
    "dist/cwqr.cjs",
    "dist/cwqr.mjs",
    "dist/*.LICENSE.txt",
    "src/i18n-res/*.json"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "astro check",
    "validate:i18n": "node i18n/test.js",
    "dev": "astro dev",
    "start": "npm run build && wrangler pages dev ./dist --compatibility-date=2026-07-01 --ip=0.0.0.0 --port=8792",
    "build": "npm run validate:i18n && npm run build:site && npm run build:lib && npm run build:pwa && npm run verify:build",
    "build:site": "npm run licenses && astro build",
    "build:lib": "webpack --mode=production --node-env=production",
    "build:pwa": "node scripts/generate-pwa.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build:dev": "npm run licenses && astro build --mode development && webpack --mode=development && npm run build:pwa",
    "build:prod": "npm run build",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "watch": "webpack --watch --mode=development",
    "serve": "astro dev",
    "prepare": "patch-package",
    "prepack": "npm run validate:i18n && npm run licenses && npm run build:lib",
    "devtunnel": "devtunnel user login -g && devtunnel host %DEVTUNNEL_ID%"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalcWorld/ClassWizQR.git"
  },
  "keywords": [
    "casio",
    "classwiz",
    "casio-calc",
    "qr"
  ],
  "author": "CalcWorld",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/CalcWorld/ClassWizQR/issues"
  },
  "homepage": "https://github.com/CalcWorld/ClassWizQR#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/preact": "^6.0.1",
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "astro": "^7.1.3",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "jsoneditor": "10.1.2",
    "mathjax": "2.7.9",
    "patch-package": "^8.0.1",
    "preact": "^10.29.7",
    "scratchblocks": "3.7.1",
    "typescript": "^6.0.3",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^3.2.7",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "workbox-build": "^7.4.1",
    "wrangler": "4.115.0",
    "zxing-wasm": "^3.1.2"
  }
}
